{
  "name": "field-capture-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite build --watch\" \"npm:dev:server\"",
    "init:env": "bash scripts/init-env.sh",
    "export:storage": "bash scripts/export-storage.sh",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "rm -rf .test-hits && tsx --env-file=.env --test --test-concurrency=1 test/*.test.ts && tsx test/check-endpoints.ts",
    "typecheck": "tsc --noEmit",
    "dev:server": "ENABLE_DEV_TOOLS=true COOKIE_SECURE=false PUBLIC_ORIGINS=http://localhost:3100 tsx watch --env-file=.env server/index.ts",
    "test:unit": "tsx --test test/curve.test.ts test/editor.test.ts test/geo.test.ts test/preflight.test.ts test/retry.test.ts test/docs.test.ts",
    "test:coverage": "rm -rf .test-hits && tsx --env-file=.env --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"server/**\" --test-coverage-include=\"shared/**\" --test-coverage-include=\"web/src/editor/**\" --test-reporter=spec test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
