# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- database (compose creates it with these) ---
POSTGRES_USER=fieldapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fieldapp

# --- host development only (docker-compose.dev.yml publishes Postgres on 127.0.0.1:5433) ---
DATABASE_URL=postgres://fieldapp:change-me@127.0.0.1:5433/fieldapp

# --- first admin, created ONLY if no admin exists yet. Never overwritten later. ---
# Change the password in the app after first login. Min 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# --- web ---
# Origins browsers will use to reach the app (comma separated). Used for the CSRF Origin check.
PUBLIC_ORIGINS=https://your-host.your-tailnet.ts.net
# true behind HTTPS (always, except plain-http local dev)
COOKIE_SECURE=true
# number of proxy hops in front of the app (Caddy = 1)
TRUST_PROXY=1

# --- tailnet profile (cert files from `tailscale cert <host>` in ./certs) ---
TAILNET_HOST=your-host.your-tailnet.ts.net
TAILNET_HTTPS_PORT=443

# --- published images: which version to pull (latest, or sha-<commit> to pin or go back) ---
IMAGE_TAG=latest

# --- public VPS profile (Caddy gets a Let's Encrypt cert) ---
DOMAIN=fieldapp.example.com

# --- object storage (RustFS, S3-compatible) for recordings ---
# host development reaches it on 127.0.0.1:9000 (docker-compose.dev.yml); containers use http://rustfs:9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too-and-long
S3_BUCKET=recordings

# --- anonymizer worker (the GPU machine that hides faces and plates) ---
# The password that machine sends. At least 32 characters (npm run init:env makes one). Leave it empty to switch
# the worker routes off; recordings are still queued and wait until a worker is allowed in.
ANONYMIZER_TOKEN=
# how long a claimed recording stays reserved for a worker that has gone quiet (minutes)
ANON_LEASE_MINUTES=15

# --- still images cut from each video (made by the same GPU machine) ---
# queue the images job when a video is built
FRAMES_ENABLED=true
# metres walked per image: the sharpest frame in every SAMPLE_STEP_M metres (1 to 50)
SAMPLE_STEP_M=3
# a recording that restarts within this many metres of where the last one stopped is one continuous walk
SAMPLE_GAP_M=15
