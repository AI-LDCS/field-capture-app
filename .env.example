# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- database (compose creates it with these) ---
POSTGRES_USER=fieldapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fieldapp

# --- first admin, created ONLY if no admin exists yet. Never overwritten later. ---
# Change the password in the app after first login. Min 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# --- web ---
# Origins browsers will use to reach the app (comma separated). Used for the CSRF Origin check.
PUBLIC_ORIGINS=https://your-host.your-tailnet.ts.net:8444
# true behind HTTPS (always, except plain-http local dev)
COOKIE_SECURE=true
# number of proxy hops in front of the app (Caddy = 1)
TRUST_PROXY=1

# --- tailnet profile (cert files from `tailscale cert <host>` in ./certs) ---
TAILNET_HOST=your-host.your-tailnet.ts.net
TAILNET_HTTPS_PORT=8444

# --- public VPS profile (Caddy gets a Let's Encrypt cert) ---
DOMAIN=fieldapp.example.com

# --- object storage (RustFS, S3-compatible). Used from milestone 2. ---
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too-and-long
S3_BUCKET=recordings
